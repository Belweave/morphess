{
  "name": "@belweave/morphess",
  "version": "0.2.4",
  "private": true,
  "description": "An independent durable coding harness for Morph inference and OpenAI-compatible models",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "morphess": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "morphess.example.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "eval": "npm run build && tsx scripts/eval.ts",
    "brand": "tsx scripts/brand.ts",
    "tui": "npm run build && node dist/cli.js tui",
    "benchmark:stream": "node --expose-gc --import tsx scripts/benchmark-stream.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-tasks": "0.2.2",
    "@opentui/core": "0.7.0",
    "commander": "^14.0.2",
    "proper-lockfile": "^4.1.2",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
